{
  "name": "ida-mcp",
  "version": "20260923.0.2",
  "description": "Official Hex-Rays IDA MCP Server.",
  "mcpServers": {
    "ida": {
      "command": "uv",
      "args": [
        "run",
        "--exclude-newer=1s",
        "--project",
        "${CLAUDE_PLUGIN_ROOT}",
        "ida-mcp",
        "stdio",
        "--agent=claude"
      ],
      "env": {
        "IDA_MCP_ID": "${IDA_MCP_ID:-}",
        "IDA_MCP_IDLE_TIMEOUT": "${IDA_MCP_IDLE_TIMEOUT:-}",
        "IDAUSR": "${IDAUSR:-}",
        "IDA_NEXUS_STATE_DIR": "${IDA_NEXUS_STATE_DIR:-}"
      }
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__(.*[_:])?ida__.*",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --exclude-newer=1s --project ${CLAUDE_PLUGIN_ROOT} ida-mcp hook claude"
          }
        ]
      }
    ]
  }
}
