{
  "name": "ida-mcp",
  "version": "0.8.1",
  "description": "Official IDA MCP server.",
  "mcpServers": {
    "ida": {
      "command": "uv",
      "args": [
        "run",
        "--project",
        "${CLAUDE_PLUGIN_ROOT}",
        "ida-mcp",
        "--agent=claude"
      ],
      "env": {
        "IDA_NEXUS_ID": "${IDA_NEXUS_ID:-}",
        "IDAUSR": "${IDAUSR:-}",
        "IDA_NEXUS_STATE_DIR": "${IDA_NEXUS_STATE_DIR:-}",
        "IDA_MCP_IDLE_TIMEOUT": "${IDA_MCP_IDLE_TIMEOUT:-}"
      }
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__(.*[_:])?ida__.*",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --project ${CLAUDE_PLUGIN_ROOT} ida-mcp --report-session=claude"
          }
        ]
      }
    ]
  }
}
