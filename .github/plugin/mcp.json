{
  "mcpServers": {
    "ida": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "run",
        "--project",
        "${PLUGIN_ROOT}",
        "ida-mcp",
        "--agent=copilot"
      ],
      "env": {
        "IDA_NEXUS_ID": "${IDA_NEXUS_ID:-}",
        "IDAUSR": "${IDAUSR:-}",
        "IDA_NEXUS_STATE_DIR": "${IDA_NEXUS_STATE_DIR:-}"
      },
      "tools": [
        "*"
      ]
    }
  }
}
