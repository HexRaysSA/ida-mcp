{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "matcher": "ida-.*",
        "type": "command",
        "exec": "uv",
        "args": [
          "run",
          "--frozen",
          "--project",
          "${PLUGIN_ROOT}",
          "ida-mcp",
          "hook",
          "copilot"
        ],
        "timeoutSec": 30
      }
    ]
  }
}
