{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "matcher": "ida-.*",
        "type": "command",
        "exec": "uv",
        "args": [
          "run",
          "--exclude-newer=1s",
          "--project",
          "${PLUGIN_ROOT}",
          "ida-mcp",
          "--report-session=copilot"
        ],
        "timeoutSec": 30
      }
    ]
  }
}
